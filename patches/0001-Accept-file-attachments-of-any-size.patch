diff --git a/apps/server/src/assets/UnboundUpload.ts b/apps/server/src/assets/UnboundUpload.ts
new file mode 100644
index 0000000000..845f5e1856
--- /dev/null
+++ b/apps/server/src/assets/UnboundUpload.ts
@@ -0,0 +1,181 @@
+// @effect-diagnostics nodeBuiltinImport:off -- copy-on-write clones and exclusive copies are filesystem boundaries missing from Effect's API.
+/**
+ * Unbound: file attachments of any size.
+ *
+ * Upstream sends an attachment as one POST and caps it at 50 MiB. A multi-gigabyte file needs
+ * more than a larger constant: Node drops a request that takes over five minutes, and a dropped
+ * connection would restart the transfer from zero. So a large file arrives as a sequence of
+ * chunks appended to one partial file, and a retry continues from the bytes already stored.
+ *
+ * The protocol reuses the signed upload URL:
+ *
+ *   POST <upload url>?unbound-offset=<bytes already sent>     body: the next chunk
+ *
+ *   200  chunk stored, more expected      body: bytes stored so far
+ *   201  upload complete                  body: the file size
+ *   409  the offset is not where the file ends; continue from the body's byte count
+ *   423  another request is still writing this upload; retry shortly
+ */
+import * as NodeFSP from "node:fs/promises";
+import { ATTACHMENT_UPLOAD_URL_TTL_MS, PROVIDER_SEND_TURN_MAX_FILE_BYTES } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Path from "effect/Path";
+import * as Stream from "effect/Stream";
+import { HttpServerResponse, type HttpServerRequest } from "effect/http";
+
+import { attachmentFileExtension } from "../attachmentStore.ts";
+import { resolveAttachmentRelativePath } from "../attachmentPaths.ts";
+import * as ServerConfig from "../config.ts";
+import * as DocumentText from "../provider/DocumentText.ts";
+
+export const UNBOUND_UPLOAD_OFFSET_PARAM = "unbound-offset";
+
+/** A chunked upload makes many requests with one URL, over hours on a slow link. */
+const UNBOUND_LARGE_UPLOAD_URL_TTL_MS = 7 * 24 * 60 * 60 * 1000;
+
+export function unboundUploadUrlTtlMs(sizeBytes: number): number {
+  return sizeBytes > PROVIDER_SEND_TURN_MAX_FILE_BYTES
+    ? UNBOUND_LARGE_UPLOAD_URL_TTL_MS
+    : ATTACHMENT_UPLOAD_URL_TTL_MS;
+}
+
+/**
+ * Claiming an upload for a thread copies it, and the pending original stays for a day. A
+ * copy-on-write clone makes that instant and free on APFS, Btrfs and XFS; elsewhere it is a copy.
+ */
+export const cloneOrCopyFile = (fromPath: string, toPath: string) =>
+  Effect.tryPromise({
+    try: () => NodeFSP.copyFile(fromPath, toPath, NodeFSP.constants.COPYFILE_FICLONE),
+    catch: (cause) => cause,
+  });
+
+interface UnboundUploadClaims {
+  readonly type: "image" | "file";
+  readonly attachmentId: string;
+  readonly name: string;
+  readonly sizeBytes: number;
+}
+
+type ChunkOutcome =
+  | { readonly status: 200 | 201 | 409; readonly receivedBytes: number }
+  | { readonly status: 400 | 423 | 500; readonly detail: string };
+
+/** One writer per upload: two requests appending to the same partial file would interleave. */
+const activeUploads = new Set<string>();
+
+const storeChunk = Effect.fn("UnboundUpload.storeChunk")(function* (
+  claims: UnboundUploadClaims,
+  offset: number,
+  body: HttpServerRequest.HttpServerRequest["stream"],
+) {
+  const config = yield* ServerConfig.ServerConfig;
+  const fileSystem = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+  const relativePath = `${claims.attachmentId}${attachmentFileExtension(claims.name)}`;
+  const finalPath = resolveAttachmentRelativePath({
+    attachmentsDir: config.attachmentsDir,
+    relativePath,
+  });
+  // The stale-upload sweep removes `.part` files an hour after their last write.
+  const partPath = resolveAttachmentRelativePath({
+    attachmentsDir: config.attachmentsDir,
+    relativePath: `${relativePath}.unbound.part`,
+  });
+  if (!finalPath || !partPath) {
+    return { status: 500, detail: "Failed to resolve attachment path." } satisfies ChunkOutcome;
+  }
+  const sizeOf = (file: string) =>
+    fileSystem.stat(file).pipe(
+      Effect.map((info) => Number(info.size)),
+      Effect.orElseSucceed(() => null),
+    );
+
+  // A client that lost the final response asks again; the upload is already published.
+  const publishedBytes = yield* sizeOf(finalPath);
+  if (publishedBytes !== null) {
+    return publishedBytes === claims.sizeBytes
+      ? ({ status: 201, receivedBytes: publishedBytes } satisfies ChunkOutcome)
+      : ({ status: 400, detail: "Attachment already uploaded." } satisfies ChunkOutcome);
+  }
+
+  yield* fileSystem.makeDirectory(path.dirname(finalPath), { recursive: true });
+  const storedBytes = (yield* sizeOf(partPath)) ?? 0;
+  if (offset !== storedBytes) {
+    return { status: 409, receivedBytes: storedBytes } satisfies ChunkOutcome;
+  }
+
+  const remainingBytes = claims.sizeBytes - offset;
+  let chunkBytes = 0;
+  yield* Stream.run(
+    body.pipe(
+      Stream.takeWhile((chunk) => {
+        chunkBytes += chunk.byteLength;
+        return chunkBytes <= remainingBytes;
+      }),
+    ),
+    fileSystem.sink(partPath, { flag: "a" }),
+  );
+  if (chunkBytes > remainingBytes) {
+    yield* fileSystem.truncate(partPath, offset);
+    return {
+      status: 400,
+      detail: `Chunk runs past the upload size of ${claims.sizeBytes} bytes.`,
+    } satisfies ChunkOutcome;
+  }
+  const receivedBytes = offset + chunkBytes;
+  if (receivedBytes < claims.sizeBytes) {
+    return { status: 200, receivedBytes } satisfies ChunkOutcome;
+  }
+
+  // Publishing without replacement keeps an upload and its cached text immutable.
+  yield* fileSystem.link(partPath, finalPath).pipe(
+    Effect.catch(() =>
+      Effect.tryPromise({
+        try: () => NodeFSP.copyFile(partPath, finalPath, NodeFSP.constants.COPYFILE_EXCL),
+        catch: (cause) => cause,
+      }),
+    ),
+  );
+  yield* fileSystem.remove(partPath, { force: true }).pipe(Effect.ignore);
+  const documents = yield* DocumentText.DocumentText;
+  yield* documents.ensure(finalPath);
+  return { status: 201, receivedBytes } satisfies ChunkOutcome;
+});
+
+/** Answers one chunk of a large upload. The caller has already verified the signed URL. */
+export const respondToAttachmentUploadChunk = Effect.fn("UnboundUpload.respond")(function* (
+  claims: UnboundUploadClaims,
+  rawOffset: string,
+  request: HttpServerRequest.HttpServerRequest,
+) {
+  const offset = /^\d{1,16}$/.test(rawOffset) ? Number(rawOffset) : Number.NaN;
+  if (claims.type !== "file" || !Number.isSafeInteger(offset) || offset > claims.sizeBytes) {
+    return HttpServerResponse.text("Invalid chunked upload request.", { status: 400 });
+  }
+  if (activeUploads.has(claims.attachmentId)) {
+    return HttpServerResponse.text("Another request is writing this upload.", { status: 423 });
+  }
+  activeUploads.add(claims.attachmentId);
+  // Keep the request stream in the route scope until the response is sent.
+  const bodyPull = yield* Stream.toPull(request.stream);
+  const outcome: ChunkOutcome = yield* storeChunk(
+    claims,
+    offset,
+    Stream.fromPull(Effect.succeed(bodyPull)),
+  ).pipe(
+    Effect.catch((cause) =>
+      Effect.logError("Failed to persist attachment upload chunk.", {
+        attachmentId: claims.attachmentId,
+        offset,
+        cause,
+      }).pipe(
+        Effect.as({ status: 500, detail: "Failed to persist upload." } satisfies ChunkOutcome),
+      ),
+    ),
+    Effect.ensuring(Effect.sync(() => activeUploads.delete(claims.attachmentId))),
+  );
+  return "detail" in outcome
+    ? HttpServerResponse.text(outcome.detail, { status: outcome.status })
+    : HttpServerResponse.text(String(outcome.receivedBytes), { status: outcome.status });
+});
