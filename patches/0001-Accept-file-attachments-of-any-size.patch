diff --git a/packages/contracts/src/chatAttachment.unbound.test.ts b/packages/contracts/src/chatAttachment.unbound.test.ts
new file mode 100644
index 0000000000..8185905b12
--- /dev/null
+++ b/packages/contracts/src/chatAttachment.unbound.test.ts
@@ -0,0 +1,53 @@
+import { assert, it } from "@effect/vitest";
+import * as Effect from "effect/Effect";
+import * as Schema from "effect/Schema";
+
+import { ChatAttachment, PROVIDER_SEND_TURN_MAX_FILE_BYTES } from "./chatAttachment.ts";
+
+const decodeAttachment = Schema.decodeUnknownEffect(ChatAttachment);
+const encodeAttachment = Schema.encodeEffect(ChatAttachment);
+
+const file = {
+  type: "file" as const,
+  id: "thread-1-00000000-0000-4000-8000-000000000003-bin",
+  name: "dataset.bin",
+  mimeType: "application/octet-stream",
+};
+const threeGiB = 3 * 1024 * 1024 * 1024;
+
+it.effect("writes a large file in the shape upstream readers accept", () =>
+  Effect.gen(function* () {
+    const encoded = yield* encodeAttachment({ ...file, sizeBytes: threeGiB });
+    assert.deepStrictEqual(encoded, {
+      ...file,
+      sizeBytes: PROVIDER_SEND_TURN_MAX_FILE_BYTES,
+      actualSizeBytes: threeGiB,
+    });
+  }),
+);
+
+it.effect("reads a large file back at its true size", () =>
+  Effect.gen(function* () {
+    const decoded = yield* decodeAttachment({
+      ...file,
+      sizeBytes: PROVIDER_SEND_TURN_MAX_FILE_BYTES,
+      actualSizeBytes: threeGiB,
+    });
+    assert.deepStrictEqual(decoded, { ...file, sizeBytes: threeGiB });
+  }),
+);
+
+it.effect("leaves a file within the upstream limit exactly as upstream writes it", () =>
+  Effect.gen(function* () {
+    const attachment = { ...file, sizeBytes: PROVIDER_SEND_TURN_MAX_FILE_BYTES };
+    assert.deepStrictEqual(yield* encodeAttachment(attachment), attachment);
+    assert.deepStrictEqual(yield* decodeAttachment(attachment), attachment);
+  }),
+);
+
+it.effect("reads a size above the upstream limit that was stored without the true-size key", () =>
+  Effect.gen(function* () {
+    const decoded = yield* decodeAttachment({ ...file, sizeBytes: threeGiB });
+    assert.strictEqual(decoded.sizeBytes, threeGiB);
+  }),
+);
