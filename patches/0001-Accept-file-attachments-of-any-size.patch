diff --git a/apps/web/src/lib/unboundChunkedUpload.ts b/apps/web/src/lib/unboundChunkedUpload.ts
new file mode 100644
index 0000000000..4daca92de0
--- /dev/null
+++ b/apps/web/src/lib/unboundChunkedUpload.ts
@@ -0,0 +1,157 @@
+/**
+ * Unbound: sends a large attachment as resumable chunks.
+ *
+ * One request per file cannot carry gigabytes: the server drops a request that takes over five
+ * minutes, and a dropped connection would restart from zero. Each chunk is a short request, and
+ * the server reports how many bytes it holds, so a retry continues from there. The protocol is
+ * documented in apps/server/src/assets/UnboundUpload.ts.
+ */
+import { PROVIDER_SEND_TURN_MAX_FILE_BYTES } from "@t3tools/contracts";
+import { msg } from "gt-react";
+
+import { m } from "../i18n/messages";
+
+/** Files up to the upstream limit keep upstream's single request, which official servers accept. */
+export const UNBOUND_CHUNKED_UPLOAD_THRESHOLD_BYTES = PROVIDER_SEND_TURN_MAX_FILE_BYTES;
+
+const UPLOAD_OFFSET_PARAM = "unbound-offset";
+/** Small enough to finish inside the server's five-minute request limit at about 0.5 Mbit/s. */
+const CHUNK_BYTES = 16 * 1024 * 1024;
+/** No bytes acknowledged for this long means the connection is dead, however slow the link. */
+const STALL_TIMEOUT_MS = 90_000;
+/** Consecutive attempts that stored nothing new before the upload gives up. */
+const MAX_FRUITLESS_ATTEMPTS = 8;
+const MAX_RETRY_DELAY_MS = 30_000;
+
+interface ChunkResponse {
+  readonly status: number;
+  readonly body: string;
+}
+
+class UploadCancelledError extends Error {}
+
+function sendChunk(input: {
+  readonly url: string;
+  readonly chunk: Blob;
+  readonly mimeType: string;
+  readonly signal: AbortSignal;
+  readonly onChunkProgress: (loadedBytes: number) => void;
+}): Promise<ChunkResponse> {
+  const xhr = new XMLHttpRequest();
+  return new Promise<ChunkResponse>((resolve, reject) => {
+    let stallTimer: ReturnType<typeof setTimeout> | undefined;
+    const armStallTimer = () => {
+      clearTimeout(stallTimer);
+      stallTimer = setTimeout(() => {
+        reject(new Error(m(msg("Upload timed out"))));
+        xhr.abort();
+      }, STALL_TIMEOUT_MS);
+    };
+    const onAbort = () => {
+      reject(new UploadCancelledError(m(msg("Upload cancelled"))));
+      xhr.abort();
+    };
+    const settle = () => {
+      clearTimeout(stallTimer);
+      input.signal.removeEventListener("abort", onAbort);
+    };
+    xhr.open("POST", input.url, true);
+    xhr.setRequestHeader("Content-Type", input.mimeType);
+    xhr.upload.addEventListener("progress", (event) => {
+      armStallTimer();
+      input.onChunkProgress(event.loaded);
+    });
+    xhr.addEventListener("load", () => {
+      settle();
+      resolve({ status: xhr.status, body: xhr.responseText });
+    });
+    xhr.addEventListener("error", () => {
+      settle();
+      reject(new Error(m(msg("Upload failed"))));
+    });
+    xhr.addEventListener("abort", settle);
+    input.signal.addEventListener("abort", onAbort, { once: true });
+    armStallTimer();
+    xhr.send(input.chunk);
+  });
+}
+
+function wait(delayMs: number, signal: AbortSignal): Promise<void> {
+  return new Promise((resolve) => {
+    const done = () => {
+      clearTimeout(timer);
+      signal.removeEventListener("abort", done);
+      resolve();
+    };
+    const timer = setTimeout(done, delayMs);
+    signal.addEventListener("abort", done, { once: true });
+  });
+}
+
+function parseStoredBytes(body: string, fileSize: number): number | null {
+  const storedBytes = /^\d{1,16}$/.test(body.trim()) ? Number(body.trim()) : Number.NaN;
+  return Number.isSafeInteger(storedBytes) && storedBytes <= fileSize ? storedBytes : null;
+}
+
+export async function uploadBytesInChunks(input: {
+  readonly url: string;
+  readonly file: File;
+  readonly mimeType: string;
+  readonly signal: AbortSignal;
+  readonly onProgress: (progress: number) => void;
+}): Promise<void> {
+  const fileSize = input.file.size;
+  let offset = 0;
+  let fruitlessAttempts = 0;
+  let lastError: Error = new Error(m(msg("Upload failed")));
+
+  while (true) {
+    if (input.signal.aborted) throw new UploadCancelledError(m(msg("Upload cancelled")));
+    if (fruitlessAttempts >= MAX_FRUITLESS_ATTEMPTS) throw lastError;
+    if (fruitlessAttempts > 0) {
+      await wait(Math.min(MAX_RETRY_DELAY_MS, 500 * 2 ** fruitlessAttempts), input.signal);
+      if (input.signal.aborted) throw new UploadCancelledError(m(msg("Upload cancelled")));
+    }
+
+    const chunkStart = offset;
+    const url = new URL(input.url, window.location.href);
+    url.searchParams.set(UPLOAD_OFFSET_PARAM, String(chunkStart));
+    let response: ChunkResponse;
+    try {
+      response = await sendChunk({
+        url: url.toString(),
+        chunk: input.file.slice(chunkStart, Math.min(chunkStart + CHUNK_BYTES, fileSize)),
+        mimeType: input.mimeType,
+        signal: input.signal,
+        onChunkProgress: (loadedBytes) =>
+          input.onProgress(Math.min(1, (chunkStart + loadedBytes) / fileSize)),
+      });
+    } catch (error) {
+      if (error instanceof UploadCancelledError) throw error;
+      // A dropped connection may still have stored part of the chunk; the next attempt asks.
+      lastError = error instanceof Error ? error : lastError;
+      fruitlessAttempts += 1;
+      continue;
+    }
+
+    if (response.status === 201) {
+      input.onProgress(1);
+      return;
+    }
+    if (response.status === 200 || response.status === 409) {
+      // On 409 the server's count wins: it holds more, or less, than this client assumed.
+      const storedBytes = parseStoredBytes(response.body, fileSize);
+      if (storedBytes === null) {
+        throw new Error(m(msg("Upload rejected ({status})", { status: response.status })));
+      }
+      fruitlessAttempts = storedBytes > offset ? 0 : fruitlessAttempts + 1;
+      offset = storedBytes;
+      input.onProgress(offset / fileSize);
+      continue;
+    }
+    lastError = new Error(m(msg("Upload rejected ({status})", { status: response.status })));
+    // Busy (423) and server or proxy errors pass; anything else will not improve on a retry.
+    if (response.status !== 423 && response.status < 500) throw lastError;
+    fruitlessAttempts += 1;
+  }
+}
